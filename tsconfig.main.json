{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src/main",
    "outDir": "dist/main",
    "tsBuildInfoFile": "dist/.main.tsbuildinfo"
  },
  "include": [
    "src/main"
  ],
  "references": [
    {
      "path": "./tsconfig.common.json"
    }
  ]
}
